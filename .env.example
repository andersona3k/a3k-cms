# Copie para .env e ajuste
PORT=3000
NODE_ENV=development

# Caminho do banco SQLite (relativo a raiz do projeto)
DB_PATH=data/cms.sqlite

# Diretorio onde a midia e gravada no filesystem
MEDIA_DIR=media

# ffprobe/ffmpeg: por padrao usam os binarios de @ffprobe-installer e
# ffmpeg-static. Defina para usar os do sistema.
# FFPROBE_PATH=ffprobe
# FFMPEG_PATH=ffmpeg

# Segredo para assinar os JWT de admin. TROQUE em producao.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

# Admin criado pelo seed
SEED_COMPANY_NAME=A3K
SEED_ADMIN_EMAIL=admin@a3k.local
SEED_ADMIN_PASSWORD=admin123
