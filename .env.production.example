# A3K CMS — .env de PRODUÇÃO. Copie para /opt/a3k-cms/.env e ajuste.
# systemd carrega este arquivo via EnvironmentFile (KEY=value, sem "export", sem aspas).

NODE_ENV=production
PORT=3000

# Estado em disco (relativo à raiz do projeto). ReadWritePaths no systemd cobre estes.
DB_PATH=data/cms.sqlite
MEDIA_DIR=media

# OBRIGATÓRIO trocar: segredo dos JWT de admin. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE-me-por-48-bytes-aleatorios
JWT_EXPIRES_IN=12h

# Admin criado pelo seed (só na primeira vez). Troque a senha.
SEED_COMPANY_NAME=A3K
SEED_ADMIN_EMAIL=admin@a3k.local
SEED_ADMIN_PASSWORD=TROQUE-esta-senha

# ffmpeg/ffprobe: por padrão usam os binários embutidos (ffmpeg-static /
# @ffprobe-installer). Descomente para usar os do sistema (apt install ffmpeg).
# FFPROBE_PATH=/usr/bin/ffprobe
# FFMPEG_PATH=/usr/bin/ffmpeg
